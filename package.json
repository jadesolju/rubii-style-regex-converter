{
  "name": "styles-regex-knowledge-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test test/app.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('public', 'dist', {recursive: true})\"",
    "start": "node --env-file-if-exists=.env dist/src/server.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "fastify": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
