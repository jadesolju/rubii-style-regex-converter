    "applyTo": "character"
  },
  {
    "id": "action-style",
    "schemaVersion": 1,
    "revision": 1,
    "locale": "th-TH",
    "status": "published",
    "title": "คำบรรยายการกระทำ",
    "summary": "แสดงข้อความ action เป็นตัวเอียงสีจาง",
    "tagName": "action",
    "template": "<span class=\"action\">$1</span>",
    "css": ".action{color:rgba(255,255,255,.6);font-style:italic}",
    "applyTo": "character"
  },
  {
    "id": "thought-style",
    "schemaVersion": 1,
    "revision": 1,
    "locale": "th-TH",
    "status": "published",
    "title": "ความคิดในใจ",
    "summary": "แสดง thought เป็นตัวเอียงพร้อมเส้นด้านซ้าย",
    "tagName": "thought",
    "template": "<div class=\"thought\">$1</div>",
